<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ColorPickerApp.App"
             RequestedThemeVariant="Dark">

    <Application.Resources>
        <!-- Renkler -->
        <SolidColorBrush x:Key="WindowBg" Color="#13151A" />
        <SolidColorBrush x:Key="PanelBg" Color="#1A1D24" />
        <SolidColorBrush x:Key="CardBg" Color="#21252E" />
        <SolidColorBrush x:Key="CardBgHover" Color="#292E39" />
        <SolidColorBrush x:Key="LineBrush" Color="#2C313C" />
        <SolidColorBrush x:Key="MutedText" Color="#8A93A6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#7B6CF6" />
        <SolidColorBrush x:Key="AccentBrushHover" Color="#9285FF" />
        <SolidColorBrush x:Key="AccentSoft" Color="#2A2650" />
        <SolidColorBrush x:Key="DangerBrush" Color="#D9534F" />
        <SolidColorBrush x:Key="DangerBrushHover" Color="#EC6560" />

        <!-- İkonlar: hepsi bu proje için elle çizildi (24x24 alanında çizgi ikonlar), üçüncü taraf ikon yok. -->
        <StreamGeometry x:Key="DropperIcon">M9 8 V4.5 A3 3 0 0 1 15 4.5 V8 M6.5 8 H17.5 M9.5 8 V17.5 L12 22 L14.5 17.5 V8 M9.5 14 H14.5</StreamGeometry>
        <StreamGeometry x:Key="CopyIcon">M9 9 H19 A1 1 0 0 1 20 10 V20 A1 1 0 0 1 19 21 H9 A1 1 0 0 1 8 20 V10 A1 1 0 0 1 9 9 Z M5 15 H4 A1 1 0 0 1 3 14 V4 A1 1 0 0 1 4 3 H14 A1 1 0 0 1 15 4 V5</StreamGeometry>
        <StreamGeometry x:Key="CloseIcon">M6 6 L18 18 M18 6 L6 18</StreamGeometry>
        <StreamGeometry x:Key="SettingsIcon">M4 7 H14 M18 7 H20 M4 17 H6 M10 17 H20 M16 4.5 V9.5 M8 14.5 V19.5</StreamGeometry>
        <StreamGeometry x:Key="PlusIcon">M12 5 V19 M5 12 H19</StreamGeometry>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{DynamicResource WindowBg}" />
        </Style>

        <!-- Küçük gri başlıklar -->
        <Style Selector="TextBlock.caption">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
        </Style>

        <!-- Metin kutuları -->
        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        </Style>

        <!-- Listeler -->
        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <!-- Proje listesi -->
        <Style Selector="ListBox.projects ListBoxItem">
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="ListBox.projects ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
        </Style>
        <Style Selector="ListBox.projects ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        </Style>
        <Style Selector="ListBox.projects ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        </Style>

        <!-- Renk kartları listesi: seçim vurgusu yok, kartın kendisi çiziliyor -->
        <Style Selector="ListBox.cards ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
        <Style Selector="ListBox.cards ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.cards ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.cards ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <Style Selector="Border.chip">
            <Setter Property="Background" Value="{DynamicResource PanelBg}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="0,2,2,2" />
        </Style>
        <Style Selector="TextBlock.chipLabel">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
        </Style>
        <Style Selector="TextBlock.chipValue">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>

        <!-- İkon çizgileri -->
        <Style Selector="Path.glyph">
            <Setter Property="Stroke" Value="{DynamicResource MutedText}" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
        </Style>
        <Style Selector="Path.glyphWhite">
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>

        <!-- Düğmeler -->
        <Style Selector="Button.icon">
            <Setter Property="Padding" Value="6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardBgHover}" />
        </Style>
        <Style Selector="Button.icon:pointerover Path.glyph">
            <Setter Property="Stroke" Value="White" />
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.accent /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrushHover}" />
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.accent:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource DangerBrushHover}" />
        </Style>
    </Application.Styles>
</Application>
